[Unit]
Description=MH02 fatigue detector
After=mh02-cabin.service
Requires=mh02-cabin.service
ConditionPathExists=/etc/mh02/config.json

[Service]
User=smartd
SupplementaryGroups=video
WorkingDirectory=/home/smartd/mh02_runtime
Environment=PYTHONPATH=/home/smartd/mh02_runtime
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/smartd/mh02_runtime/.venv/bin/python -m mh02_runtime.fatigue_service --camera-id cabin --config-path /etc/mh02/config.json --app-root /home/smartd/mh02_runtime/legacy_mh02
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mh02-fatigue

[Install]
WantedBy=multi-user.target
