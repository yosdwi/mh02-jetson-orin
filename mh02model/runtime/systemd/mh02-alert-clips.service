[Unit]
Description=MH02 alert evidence clip exporter
After=mh02-alerts.service mh02-vlog.service
Requires=mh02-alerts.service mh02-vlog.service

[Service]
User=smartd
WorkingDirectory=/home/smartd/mh02_runtime
Environment=PYTHONPATH=/home/smartd/mh02_runtime
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/smartd/mh02_runtime/.venv/bin/python -m mh02_runtime.alert_clip_service
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mh02-alert-clips

[Install]
WantedBy=multi-user.target
