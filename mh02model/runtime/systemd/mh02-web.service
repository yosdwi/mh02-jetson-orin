[Unit]
Description=MH02 operations web dashboard
After=mh02-vlog.service mh02-aggregate.service

[Service]
User=smartd
WorkingDirectory=/home/smartd/mh02_runtime
Environment=PYTHONPATH=/home/smartd/mh02_runtime
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/smartd/mh02_runtime/.venv/bin/python -m mh02_runtime.web_server --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mh02-web

[Install]
WantedBy=multi-user.target
