[Unit]
Description=MH02 hourly Parquet datalogger
After=mh02-aggregate.service
Requires=mh02-aggregate.service

[Service]
User=smartd
WorkingDirectory=/home/smartd/mh02_runtime
Environment=PYTHONPATH=/home/smartd/mh02_runtime
ExecStart=/home/smartd/mh02_runtime/.venv/bin/python -m mh02_runtime.datalogger_service
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
