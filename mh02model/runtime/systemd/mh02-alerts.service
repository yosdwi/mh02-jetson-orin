[Unit]
Description=MH02 fatigue alert lifecycle service
After=mh02-aggregate.service
Requires=mh02-aggregate.service

[Service]
User=smartd
WorkingDirectory=/home/smartd/mh02_runtime
Environment=PYTHONPATH=/home/smartd/mh02_runtime
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/smartd/mh02_runtime/.venv/bin/python -m mh02_runtime.alert_service
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mh02-alerts

[Install]
WantedBy=multi-user.target
