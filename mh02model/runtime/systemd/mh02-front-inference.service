[Unit]
Description=MH02 NVIDIA DeepStream front inference
After=mh02-vlog.service mh02-mediamtx.service
Requires=mh02-mediamtx.service
ConditionPathExists=/etc/mh02/config.json
ConditionPathExists=/etc/mh02/models/dashcamnet.engine

[Service]
User=smartd
SupplementaryGroups=video
WorkingDirectory=/home/smartd/mh02_runtime
Environment=PYTHONPATH=/home/smartd/mh02_runtime:/opt/nvidia/deepstream/deepstream-6.2/lib
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/smartd/mh02_runtime/.venv/bin/python -m mh02_runtime.front_inference_service --config-path /etc/mh02/config.json
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mh02-front-inference

[Install]
WantedBy=multi-user.target
